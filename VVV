<script>
  // Helper padStart versi ES5 agar kompatibel dengan browser lama
  function padLeft(val, len) {
    var str = String(val);
    while (str.length < len) {
      str = '0' + str;
    }
    return str;
  }

  var hlsInstance = null;
  var streamUrl = 'https://cdn-globecast.akamaized.net/live/eds/saudi_quran/hls_roku/index.m3u8';

  function toggleStreaming() {
    var streamOverlay = document.getElementById('streamOverlay');
    var video = document.getElementById('streamVideo');

    if (streamOverlay.style.display === 'flex') {
      streamOverlay.style.display = 'none';
      video.pause();
      if (hlsInstance) {
        hlsInstance.destroy();
        hlsInstance = null;
      }
    } else {
      streamOverlay.style.display = 'flex';
      if (typeof Hls !== 'undefined' && Hls.isSupported()) {
        hlsInstance = new Hls();
        hlsInstance.loadSource(streamUrl);
        hlsInstance.attachMedia(video);
        hlsInstance.on(Hls.Events.MANIFEST_PARSED, function() {
          video.play();
        });
      } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
        video.src = streamUrl;
        video.addEventListener('loadedmetadata', function() {
          video.play();
        });
      }
    }
  }

  document.addEventListener('keydown', function(e) {
    var quoteOverlay = document.getElementById('quoteOverlay');
    var imgTengah = document.getElementById('gambarTengah');
    var key = e.key || e.keyCode;

    if (key === '1' || key === 49) toggleFullscreen();

    if (key === '2' || key === 50) {
      if (typeof financeBox !== 'undefined' && financeBox) {
        financeBox.classList.toggle('active');
        if(quoteOverlay) quoteOverlay.classList.remove('active');
      }
    }

    if (key === '3' || key === 51) {
      if (imgTengah) {
        if (imgTengah.getAttribute('src') === 'pengumuman3.jpg') {
          imgTengah.setAttribute('src', 'masjid2.jpg');
        } else {
          imgTengah.setAttribute('src', 'pengumuman3.jpg');
        }
      }
    }

    if (key === '4' || key === 52) toggleStreaming();

    if (key === '5' || key === 53) {
      if (imgTengah) {
        if (imgTengah.getAttribute('src') === 'pengumuman5.jpg') {
          imgTengah.setAttribute('src', 'masjid2.jpg');
        } else {
          imgTengah.setAttribute('src', 'pengumuman5.jpg');
        }
      }
    }

    if (key === '6' || key === 54) {
      if (quoteOverlay) {
        quoteOverlay.classList.toggle('active');
        if (typeof financeBox !== 'undefined' && financeBox) financeBox.classList.remove('active');
        var marqueeEl = quoteOverlay.querySelector('marquee');
        if (marqueeEl && quoteOverlay.classList.contains('active')) {
          marqueeEl.start();
        }
      }
    }

    if (key === '7' || key === 55) {
      var theme = document.getElementById("theme-link");
      if (theme) {
        if (theme.getAttribute("href") === "style5.css") {
          theme.setAttribute("href", "style-K.css");
        } else {
          theme.setAttribute("href", "style5.css");
        }
      }
    }

    if (key === 'Enter' || key === 13) toggleFullscreen();
  }); 

  function toggleFullscreen() {
    if (!document.fullscreenElement && !document.webkitFullscreenElement && !document.mozFullScreenElement) {
      var docElm = document.documentElement;
      if (docElm.requestFullscreen) { docElm.requestFullscreen(); }
      else if (docElm.webkitRequestFullScreen) { docElm.webkitRequestFullScreen(); }
      else if (docElm.mozRequestFullScreen) { docElm.mozRequestFullScreen(); }
    } else {
      if (document.exitFullscreen) { document.exitFullscreen(); }
      else if (document.webkitCancelFullScreen) { document.webkitCancelFullScreen(); }
      else if (document.mozCancelFullScreen) { document.mozCancelFullScreen(); }
    }
  }

  document.addEventListener('click', function(e) {
    if (e.target.tagName !== 'VIDEO') {
      toggleFullscreen();
    }
  });
</script>

<script>
// Algoritma Hijriah manual yang aman untuk Chrome lama
function getHijriDate(date) {
  var d = date.getDate();
  var m = date.getMonth();
  var y = date.getFullYear();

  if (m < 2) {
    y -= 1;
    m += 12;
  }
  var a = Math.floor(y / 100);
  var b = 2 - a + Math.floor(a / 4);
  // Menambahkan offset +32 hari agar 7 Safar maju menjadi 10 Rabiul Awal
var jd = Math.floor(365.25 * (y + 4716)) + Math.floor(30.6001 * (m + 1)) + d + b - 1524.5 + 32;

  
  var z = jd - 1948439.5;
  var cyc = Math.floor(z / 10631);
  z -= cyc * 10631;
  var iy = Math.floor((z - 0.5) / 354.366);
  var hy = cyc * 30 + iy + 1;
  z -= Math.round(iy * 354.366);
  var hm = Math.floor((z + 28.5) / 29.5);
  if (hm > 12) hm = 12;
  var hd = Math.floor(z - Math.round((hm - 1) * 29.5) + 1);

  return { day: hd, month: hm, year: hy };
}

setInterval(function() {
  var n = new Date();
  document.getElementById("hDisplay").textContent = padLeft(n.getHours(), 2);
  document.getElementById("mDisplay").textContent = padLeft(n.getMinutes(), 2);

  var hari = ["Minggu","Senin","Selasa","Rabu","Kamis","Jumat","Sabtu"];
  var bulan = ["Januari","Februari","Maret","April","Mei","Juni","Juli","Agustus","September","Oktober","November","Desember"];

  var tanggalDisplay = document.getElementById("tanggalDisplay");
  if(tanggalDisplay) {
     tanggalDisplay.textContent = hari[n.getDay()] + ", " + n.getDate() + " " + bulan[n.getMonth()] + " " + n.getFullYear();
  }

  var hijriMonths = ["Muharram","Safar","Rabiul Awal","Rabiul Akhir","Jumadil Awal","Jumadil Akhir","Rajab","Sya'ban","Ramadhan","Syawal","Dzulqaidah","Dzulhijjah"];
  var hData = getHijriDate(n);

  var hijriDisplay = document.getElementById("hijriDisplay");
  if(hijriDisplay) {
     hijriDisplay.innerHTML = hData.day + " " + hijriMonths[hData.month - 1] + " " + hData.year + " H";
  }
}, 1000);  
</script>

