<script>
function parseCSV(text){
  var lines = text.split(/\r?\n/);
  var result = [];
  for(var i=0; i<lines.length; i++) {
    if(lines[i].trim() !== "") {
      if(i === 0) continue; // Skip Header
      var cells = [], cur = {v:"", q:false};
      var line = lines[i];
      for(var j=0; j<line.length; j++){
        var c = line[j];
        if(c === '"'){cur.q = !cur.q; continue;}
        if(c === ',' && !cur.q){cells.push(cur.v.trim()); cur.v=''; continue;}
        cur.v += c;
      }
      cells.push(cur.v.trim());
      result.push(cells);
    }
  }
  return result;
}

if (typeof rawData !== 'undefined') {
  var rows = parseCSV(rawData);
  function getTodayRow(){
    var now = new Date();
    var d = padLeft(now.getDate(), 2);
    var m = padLeft(now.getMonth()+1, 2);
    var y = now.getFullYear();
    var todayStr = d + "/" + m + "/" + y;
    for(var k=0; k<rows.length; k++) {
      if(rows[k][0] && rows[k][0].indexOf(todayStr) !== -1) {
        return rows[k];
      }
    }
    return null;
  }

  var today = getTodayRow();
  if(today){
    document.getElementById("imsak").textContent   = today[1];
    document.getElementById("subuh").textContent   = today[2];
    document.getElementById("dzuhur").textContent  = today[3];
    document.getElementById("ashar").textContent   = today[4];
    document.getElementById("maghrib").textContent = today[5];
    document.getElementById("isya").textContent    = today[6];

    window.jadwal = {
      subuh: today[2],
      dzuhur: today[3],
      ashar: today[4],
      maghrib: today[5],
      isya: today[6]
    };
  }
}
</script>

<script>
var modeIqomahActive = false;
var sedangProses = false;
var statusAdzan = {};
var hariIni = new Date().getDay(); 

function updateCountdown(){
  if(!window.jadwal) return;

  var now = new Date(new Date().getTime() + 28000);
  var today = new Date();

  var list = [
    { n:"Subuh",   t: jadwal.subuh },
    { n:"Dzuhur",  t: jadwal.dzuhur },
    { n:"Ashar",   t: jadwal.ashar },
    { n:"Maghrib", t: jadwal.maghrib },
    { n:"Isya",    t: jadwal.isya }
  ];

  var next = null;
  for(var i=0; i<list.length; i++) {
    var j = list[i];
    var parts = j.t.split(":");
    var d = new Date(today.getFullYear(), today.getMonth(), today.getDate(), parseInt(parts[0], 10), parseInt(parts[1], 10), 0);
    if(d > now && !next){
      next = { n: j.n, t: j.t, d: d };
    }
  }

  if(!next){
    var partsSubuh = jadwal.subuh.split(":");
    var besokSubuh = new Date(today.getFullYear(), today.getMonth(), today.getDate() + 1, parseInt(partsSubuh[0], 10), parseInt(partsSubuh[1], 10), 0);
    next = { n: "Subuh", d: besokSubuh };
  }

  var diff = next.d - now;
  var totalDetik = Math.floor(diff / 1000);                                             
  var h = padLeft(Math.floor(diff / 3600000), 2);
  var m = padLeft(Math.floor((diff % 3600000) / 60000), 2);
  var s = padLeft(Math.floor((diff % 60000) / 1000), 2);

  var countdownElement = document.getElementById("countdown");
  if(countdownElement) countdownElement.textContent = next.n.toUpperCase() + " : " + h + ": " + m + ": " + s;

  var overlay = document.getElementById("universalOverlay");
  var overlayCD = document.getElementById("overlayCountdown");
  var overlayStatus = document.getElementById("overlayStatus");
  var jumatOverlay = document.getElementById("jumatOverlay");
  var jumatCD = document.getElementById("jumatCountdown");
  var beep = document.getElementById("beepAudio");

  overlay.style.display = "none";
  jumatOverlay.style.display = "none";

  if(totalDetik <= 300 && totalDetik > 0){
    if(hariIni === 5 && next.n === "Dzuhur"){
      jumatOverlay.style.display = "flex";
      jumatCD.textContent = m + ":" + s;
    } else {
      overlay.style.display = "flex";
      overlayStatus.textContent = "MENUJU ADZAN";
      overlayCD.textContent = m + ":" + s;
      overlayCD.style.color = "white"; 
    }
  }
  else if(totalDetik === 0){
    if(beep) beep.play();
    if(hariIni === 5 && next.n === "Dzuhur"){
      modeIqomahActive = false;
      jumatOverlay.style.display = "flex";
    } else {
      setTimeout(function(){
        modeIqomahActive = true;
        window.iqomahEnd = new Date().getTime() + 480000; 
      }, 5000);
    }
  }
  else if(modeIqomahActive){
    var sisa = window.iqomahEnd - new Date().getTime();
    if(sisa > 0){
      overlay.style.display = "flex";
      overlayStatus.textContent = "MENUJU IQOMAH";
      overlayStatus.style.color = "white";
      overlayStatus.style.fontSize = "4rem";       
      overlayStatus.style.letterSpacing = "5px";   
      var im = padLeft(Math.floor(sisa/60000), 2);
      var is = padLeft(Math.floor((sisa%60000)/1000), 2);
      overlayCD.textContent = im + ":" + is;
    } else {
      overlay.style.display = "none";
      modeIqomahActive = false;
    }
  }
}
setInterval(updateCountdown, 1000);
</script>

<script>
var hariBesar = [
  {n:"Isra Mi'raj Nabi (ﷺ)",m:1,d:16},
  {n:"Awal Ramadhan",m:2,d:19},
  {n:"Nuzulul Qur'an",m:3,d:7},
  {n:"Idul Fitri",m:3,d:20},
  {n:"Idul Adha",m:5,d:27},
  {n:"Tahun Baru Islam",m:6,d:16},
  {n:"Maulid Nabi (ﷺ)",m:8,d:25}
];

function updateHariBesar(){
  var now = new Date();
  var dekat = null, sel = 9999;
  for(var i=0; i<hariBesar.length; i++) {
    var h = hariBesar[i];
    var t = new Date(now.getFullYear(), h.m-1, h.d);
    if (t < now) t.setFullYear(t.getFullYear()+1);
    var s = Math.ceil((t-now)/86400000);
    if (s < sel){ sel = s; dekat = h; }
  }
  var hbText = document.getElementById("hariBesarText");
  if(hbText && dekat) hbText.textContent = dekat.n + " — " + sel + " hari lagi";
}
updateHariBesar();
</script>

<script>
setInterval(function() {
  if (!window.jadwal || sedangProses) return;
  var now = new Date(new Date().getTime() + 28000);
  var jamSekarang = padLeft(now.getHours(), 2) + ":" + padLeft(now.getMinutes(), 2);
  var waktuArr = ["subuh","dzuhur","ashar","maghrib","isya"];
  
  for(var i=0; i<waktuArr.length; i++) {
    var w = waktuArr[i];
    if (window.jadwal[w] === jamSekarang && !statusAdzan[w]) {
      sedangProses = true;
      statusAdzan[w] = true;
      var audio = document.getElementById("adzanAudio");
      if(audio) audio.play();
    }
  }
}, 1000);

setInterval(function() {
  var n = new Date();
  if(n.getHours() === 0 && n.getMinutes() === 0) statusAdzan = {};
}, 60000);
</script>

